# EC2 A/B in the same VPC. Use PRIVATE IPv4, never public IP/Elastic IP.
# Run lab.py init on A and copy the SAME .env to B. Do not use the production .env.
SERVER_A_IP=10.0.1.10
SERVER_B_IP=10.0.1.11
BACKEND_IMAGE=smartticketing-distributed:ec2
# Persist proxy mode across container/EC2 restarts; one or two backends.
LAB_MODE=two
MYSQL_PASSWORD=change-this-lab-password
REDIS_PASSWORD=change-this-lab-redis-password
JWT_SECRET=change-this-lab-jwt-secret-at-least-32-bytes
# No container CPU/memory quota or fixed JVM heap size; use the EC2 host resources.
DB_POOL_SIZE=10
DDL_MODE=validate
ADMISSION_ENABLED=false
# Shared across A/B. Used for the admission correctness check, not capacity tuning.
ADMISSION_CAPACITY=100
ADMISSION_BATCH_SIZE=10
ADMISSION_NAMESPACE=distributed-lab
