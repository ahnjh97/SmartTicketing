# Copy to .env on A and B. Use the SAME values, image and DB URL on both hosts.
SERVER_A_IP=192.168.0.10
SERVER_B_IP=192.168.0.11
BACKEND_IMAGE=smartticketing-distributed:local
MYSQL_PASSWORD=change-this-lab-password
REDIS_PASSWORD=change-this-lab-redis-password
JWT_SECRET=change-this-lab-jwt-secret-at-least-32-bytes
BACKEND_CPUS=2
BACKEND_MEMORY=2g
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1024m
DB_POOL_SIZE=10
DDL_MODE=validate
ADMISSION_ENABLED=false
