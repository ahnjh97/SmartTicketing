# Copy to .env.benchmark at the repository root (ignored by Git).
# Local MySQL 127.0.0.1:3306; account must be allowed to create/drop test databases.
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password
# Source DB containing the team's actual Seoul theater catalog (read only).
BENCH_SOURCE_DB_URL=jdbc:mysql://127.0.0.1:3306/smart_ticketing?serverTimezone=Asia/Seoul
# Optional BENCH_SOURCE_DB_USERNAME / BENCH_SOURCE_DB_PASSWORD override DB credentials above.
# Required only for explicit live mode. Default plan and stub never call Kakao.
KAKAO_MAP_REST_API_KEY=
